# Copie este arquivo para ".env" e preencha. O ".env" NUNCA vai para o GitHub.

# Dados do aplicativo criado no Portal do Desenvolvedor do Conta Azul
CONTAAZUL_CLIENT_ID=
CONTAAZUL_CLIENT_SECRET=

# Tem que ser exatamente igual à "URL de redirecionamento" cadastrada no aplicativo
CONTAAZUL_REDIRECT_URI=http://localhost:3000/oauth/retorno

# Escopo pedido na autorização. Confira no portal se ainda é este.
CONTAAZUL_SCOPE=openid profile aws.cognito.signin.user.admin

# false = SIMULAÇÃO: o painel mostra o que seria enviado, mas não cria nada no Conta Azul.
# Só troque para true depois de conferir as simulações (ver docs/GUIA.md, passo 6).
ENVIO_REAL=false

# Porta do painel (http://localhost:3000)
PORTA=3000
