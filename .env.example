# Use "npm run configurar": ele cria o .env em <pasta do usuário>/nf-conta-azul e abre para editar.
# O .env NUNCA vai para o GitHub.

# Dados do aplicativo criado no Portal do Desenvolvedor do Conta Azul
CONTAAZUL_CLIENT_ID=
CONTAAZUL_CLIENT_SECRET=

# Tem que ser exatamente igual à URL de redirecionamento do aplicativo.
# App de DESENVOLVIMENTO: é fixa, https://contaazul.com
# App de PRODUÇÃO: a que você cadastrar (ex.: http://localhost:3000/oauth/retorno)
CONTAAZUL_REDIRECT_URI=https://contaazul.com

# Escopo pedido na autorização (confirmado no portal)
CONTAAZUL_SCOPE=openid profile aws.cognito.signin.user.admin

# false = SIMULAÇÃO: o painel mostra o que seria enviado, mas não cria nada no Conta Azul.
ENVIO_REAL=false

# Situação com que a venda nasce no Conta Azul: APROVADO ou EM_ANDAMENTO
SITUACAO_VENDA=APROVADO

# Forma de pagamento usada quando a OS não informa (ex.: PIX_PAGAMENTO_INSTANTANEO, DINHEIRO,
# CARTAO_CREDITO, CARTAO_DEBITO, BOLETO_BANCARIO). Deixe vazio para não informar.
FORMA_PAGAMENTO_PADRAO=

# Planilha de SKUs (Google Sheets) – veja docs/PLANILHA.md. Vazio = só cria no Conta Azul.
PLANILHA_URL=
PLANILHA_TOKEN=

# Porta do painel (http://localhost:3000)
PORTA=3000
